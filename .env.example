DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pooja_invoice"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="admin@poojaxerox"
ADMIN_PASSWORD="3647"

# Groq LLM
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# Meta WhatsApp Cloud API
WHATSAPP_META_TOKEN="EAAxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_OWNER_PHONE="919324290047"
WHATSAPP_OWNER_PHONE_2="91XXXXXXXXXX"
# Send the owner a confirmation after each real automatic payment-reminder email.
WHATSAPP_EMAIL_CONFIRMATIONS="false"

# Vercel Cron — secures /api/cron/whatsapp-reminders
# Must also be set in Vercel Dashboard → Settings → Environment Variables
CRON_SECRET="your-strong-random-secret-here"

# Email Sending (Gmail SMTP or any standard SMTP) — Global Defaults
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="Pooja Xerox <your-email@gmail.com>"

# Profile-Specific Email Sending
# 1. Pooja Xerox
POOJA_XEROX_SMTP_USER="pooja.xerox2007@gmail.com"
POOJA_XEROX_SMTP_PASS="your-pooja-xerox-app-password"
POOJA_XEROX_SMTP_FROM="Pooja Xerox <pooja.xerox2007@gmail.com>"

# 2. Pooja Enterprises
POOJA_ENTERPRISES_SMTP_USER="poojacomputersstationery@gmail.com"
POOJA_ENTERPRISES_SMTP_PASS="your-pooja-enterprises-app-password"
POOJA_ENTERPRISES_SMTP_FROM="Pooja Enterprises <poojacomputersstationery@gmail.com>"
